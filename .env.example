# ==============================================================================
# Steam Game Picker — Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# KULLANIM TALİMATI:
# 1. Bu dosyayı kopyalayarak '.env' adında yeni bir dosya oluşturun:
#    cp .env.example .env (veya Windows'ta: copy .env.example .env)
# 2. Gerçek değerlerinizi '.env' dosyasına yazın.
# 3. DİKKAT: '.env' dosyasını ve Steam API anahtarınızı asla Git'e commit'lemeyin!
# ==============================================================================

# Sunucu Port Numarası (Varsayılan: 3000)
PORT=3000

# Çalışma Ortamı ('development' veya 'production')
# Canlıya alırken kesinlikle 'production' yapın (detaylı hata ve stack trace gizlenir)
NODE_ENV=development

# Steam Web API Anahtarı
# Resmi Steam Developer Portal üzerinden ücretsiz temin edilir:
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# İzin Verilen Kökenler (CORS Allowlist)
# Canlı ortamda (NODE_ENV=production) yalnızca bu adresten gelen isteklere izin verilir.
# Birden fazla adres için virgülle ayırabilirsiniz:
# Örnek: https://steampicker.com,https://www.steampicker.com
ALLOWED_ORIGIN=http://localhost:3000